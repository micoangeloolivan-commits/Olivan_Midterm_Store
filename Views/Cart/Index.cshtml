@model List<Olivan_Midterm_Store.Models.CartItem>

@{ ViewData["Title"] = "CartItem"; }

 

<h1>Cart_Items</h1>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Items</a>

 

<table class="table table-bordered">

    <thead>

        <tr>
            <th>Id</th>
            <th>ProductId</th>
            <th>ProductName</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Actions</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var p in Model)

        {

            <tr>
                <td>@p.Id</td>
                <td>@p.ProductId</td>
                <td>@p.ProductName</td>
                <td>@p.Price</td>
                <td>@p.Quantity</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete this product?')">Delete</a>
                </td>
            </tr>

        }

    </tbody>

</table>

