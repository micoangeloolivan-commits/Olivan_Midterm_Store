@model IEnumerable<Olivan_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h1>Shopping Cart</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>

                <td>
                    ₱@item.Price.ToString("N2")
                </td>

                <td>
                    @item.Quantity
                </td>

                <td>
                    ₱@((item.Price * item.Quantity).ToString("N2"))
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Remove
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h3>
    Total:
    ₱@Model.Sum(item => item.Price * item.Quantity).ToString("N2")
</h3>