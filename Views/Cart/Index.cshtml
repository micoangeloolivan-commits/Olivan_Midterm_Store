@model List<Olivan_Midterm_Store.Models.CartItem>

@{ ViewData["Title"] = "CartItem"; }

 

<h1>Cart_Items</h1>

 

<table class="table table-bordered">

    <thead>

        <tr>
            <th>ID</th>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Actions</th>
        </tr>

    </thead>

    <form asp-action="Index" method="get" class="mb-3">
            <input type="text" name="searchString" value="@ViewData["searchString"]"
               placeholder="Search item name..." />
            <button type="submit">Search</button>
        <a asp-action="Index">Clear</a>
    </form>

    <tbody>

        @foreach (var p in Model)

        {

            <tr>
                <td>@p.Id</td>
                <td>@p.ProductId</td>
                <td>@p.ProductName</td>
                <td>@p.Price</td>
                <td>@p.Quantity</td>
                <td>
                    <a asp-action="Edit" 
                    asp-route-id="@p.Id" 
                    class="btn btn-sm btn-warning">
                    Edit
                    </a>

                    <a asp-action="Delete" 
                    asp-route-id="@p.Id" 
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('Delete this Item?')">
                    Delete
                    </a>
                </td>
            </tr>

        }


    </tbody>

</table>

<h1>
    Total:
    $@Model.Sum(item => item.Price * item.Quantity).ToString("N2")
</h1>