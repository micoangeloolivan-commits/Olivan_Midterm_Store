@model List<Olivan_Midterm_Store.Models.Product>

@{ ViewData["Title"] = "Products"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
</div>

    <form asp-action="Index" method="get" class="mb-3">
        <input type="text" name="searchString" value="@ViewData["searchString"]"
               placeholder="Search product name..." />
        <button type="submit">Search</button>
        <a asp-action="Index">Clear</a>
    </form>

<div class="row">
    @foreach (var p in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">@p.Category</span>
                    <h5 class="card-title">@p.Name</h5>
                    <p class="card-text">@p.Description</p>
                    <p class="fw-bold fs-5">@p.Price</p>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@p.Id"
                       class="btn btn-success btn-sm">Add to Cart</a>
                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id"
                       class="btn btn-warning btn-sm">Edit</a>
                    <a asp-controller="Products" asp-action="Delete" asp-route-id="@p.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this product?')">Delete</a>
                </div>
            </div>
        </div>
    }

</div>