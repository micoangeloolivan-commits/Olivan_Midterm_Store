@model List<Olivan_Midterm_Store.Models.Product>

@{ ViewData["Title"] = "Products"; }

 

<h1>Products</h1>

<a asp-action="Create" class="btn btn-primary mb-3">+ Add Product</a>

 

<table class="table table-bordered">

    <thead>

        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Category</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var p in Model)

        {

            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Description</td>
                <td>@p.Price</td>
                <td>@p.Category</td>
            </tr>

        }

    </tbody>

</table>

